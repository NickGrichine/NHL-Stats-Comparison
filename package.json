{
  "name": "nhl-comparison",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Compare any NHL skater, goalie or team from any season since 1917-18, with era-adjusted percentile radar charts.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "data": "node scripts/fetch-data.mjs",
    "data:dev": "node scripts/fetch-data.mjs --out=public/data",
    "data:live": "node scripts/fetch-data.mjs --live-only"
  },
  "dependencies": {
    "chart.js": "^4.4.7",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
